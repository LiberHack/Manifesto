# Supabase (cloud) — Dashboard > Project Settings > API
NUXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NUXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
NUXT_SUPABASE_SECRET_KEY=sb_secret_...

# Full app URL — used in email confirmation links
NUXT_SITE_URL=https://yourdomain.com

# Optional: override where users land after email verification (defaults to /ops/confirm)
# Must match additional_redirect_urls in supabase/config.toml
NUXT_PUBLIC_EMAIL_VERIFIED_REDIRECT_URL=https://yourdomain.com/ops/confirm

# Resend (transactional email)
NUXT_RESEND_API_KEY=re_...
NUXT_RESEND_FROM_EMAIL=noreply@yourdomain.com

DOMAIN=yourdomain.com

# Production (Cloudflare Workers): public values live in wrangler.jsonc `vars`,
# secrets are set with `npx wrangler secret put <NAME>`. This file is for local dev only.
