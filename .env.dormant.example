# .env.dormant.example — dormant (archived) site configuration
# Copy to .env and fill in real values for a dormant static build.
NUXT_PUBLIC_SITE_MODE=dormant
NUXT_PUBLIC_SUPABASE_URL=https://placeholder.supabase.co
NUXT_PUBLIC_SUPABASE_ANON_KEY=placeholder-anon-key
# Leave service key and email tokens unset for static builds — server routes are not used.
